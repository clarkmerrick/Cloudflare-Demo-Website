{
  "name": "demo-auto-router-chat",
  "main": "../workers/ai-chat.mjs",
  "account_id": "c90488e647c2c6abe6544e5d35d59249",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1, "persist": true }
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "USAGE_DB", "database_name": "demo-auto-router-usage", "database_id": "a46d6535-5c05-4f05-ba98-0cbeb8cb40ec" }
  ],
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1014",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "routes": [
    { "pattern": "demo.clarkmerrick.com/api/ai-chat", "zone_id": "df194a551022ee768d93a48d2aff4647" },
    { "pattern": "demo.clarkmerrick.com/api/ai-stats", "zone_id": "df194a551022ee768d93a48d2aff4647" }
  ]
}
